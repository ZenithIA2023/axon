
# Credenciais - nunca commitar
*firebase-adminsdk*.json
*serviceAccountKey*.json
google-services.json

# Keystore de assinatura: perdê-la impede atualizar o app publicado, e
# vazá-la permite que terceiros assinem builds falsos como se fossem nossos.
*.jks
*.keystore
keystore.properties

# Rede de segurança: qualquer .json solto na RAIZ do repo. Nenhum arquivo
# legítimo do projeto mora aqui — os que importam estão em axonweb/ e backend/.
# Credenciais baixadas costumam cair na raiz, e é assim que vazam.
/*.json
!/package.json
!/package-lock.json

# Mesma lógica para áudio solto na raiz: amostras de voz gravadas para testar
# a Fase 2 (transcrição) — dados pessoais, não fazem parte do projeto.
/*.ogg
/*.webm
/*.m4a
/*.mp3
/*.wav

# Claude Code: config pessoal fica local, skills vao pro repo
.claude/settings.local.json
