ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...
FRONTEND_URL=http://localhost:5173
# Produção: FRONTEND_URL=https://axonapp.tech

# Origens extras liberadas no CORS, separadas por vírgula.
# O WebView do app Android (Capacitor) faz requisições com origem
# "https://localhost" — sem liberá-la, o app instalado recebe 400 no preflight
# e nenhuma chamada autenticada funciona.
CORS_ORIGINS=https://localhost
# Produção: CORS_ORIGINS=https://localhost,https://axonapp.tech

# "development" habilita /docs e /redoc; qualquer outro valor (ou ausente) desabilita em produção
ENV=development

# Google OAuth (obrigatório para login com Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Produção: GOOGLE_REDIRECT_URI=https://api.axonapp.tech/auth/google/callback
# (cadastrar essa URL no Google Cloud Console antes de publicar)

# Push notifications (FCM). Use UMA das duas formas:
#  - PATH: caminho de um arquivo JSON no disco (desenvolvimento)
#  - JSON: o conteúdo colado numa variável (Railway, onde não há arquivo)
# A credencial é a "chave privada de conta de serviço" do Firebase e NUNCA
# pode ser commitada — quem a tiver envia push como se fosse a gente.
# Sem nenhuma das duas, o push simplesmente não é enviado; nada mais quebra.
FIREBASE_CREDENTIALS_PATH=/caminho/para/firebase-key.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ---------------------------------------------------------------------------
# Voz do Axon (TTS + STT)
# ---------------------------------------------------------------------------
# Síntese: TRÊS provedores opcionais e independentes — cada um só aparece no
# seletor de vozes se a credencial dele existir. Sem nenhum, o app cai para a
# voz do aparelho (que soa artificial — por isso os provedores existem).
# Transcrição: só o Google por ora (Fase 2).
#
# GOOGLE: não precisa de chave nova. Reusa a service account do Firebase
# (FIREBASE_CREDENTIALS_* acima), mas exige habilitar a API uma vez no console:
#   https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
#   https://console.cloud.google.com/apis/library/speech.googleapis.com
# Se o TTS/STT morar em outro projeto GCP que não o do Firebase:
# GCP_PROJECT_ID=

# ELEVENLABS: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5   # padrão: o de menor latência

# OPENAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Teto de segundos de áudio transcritos por usuário/mês (Google STT cobra por
# segundo). 0 ou negativo desliga o teto — útil em desenvolvimento.
# VOICE_STT_MONTHLY_LIMIT_SECONDS=3600

# Provedor de transcrição: "openai" (padrão), "openrouter" ou "google".
#
# A OpenAI é 4x mais barata que o Google (US$0,0045/min contra US$0,024) e o
# parâmetro `prompt` dela funciona como vocabulário de verdade — o `adaptation`
# do Google é aceito e silenciosamente ignorado, o que fazia "Axon" virar
# "Jackson"/"acson"/"Akon" a cada gravação.
# Exige OPENAI_API_KEY (a mesma chave já usada pelo TTS da OpenAI).
#
# "openrouter" serve o mesmo modelo com uma chave só (OPENROUTER_API_KEY) e é
# útil para comparar fornecedores, mas NÃO repassa o `prompt` (o vocabulário do
# usuário não chega ao modelo) e não tem streaming. Use só para teste.
# VOICE_STT_PROVIDER=openai

# Modelo da OpenAI. O padrão é "gpt-transcribe", escolhido comparando 14 modelos
# com o mesmo áudio em pt-BR: 100% de acerto contra 71% do "gpt-4o-transcribe",
# além de mais barato e mais rápido. Alternativas: "gpt-4o-transcribe",
# "gpt-4o-mini-transcribe", "whisper-1".
# OPENAI_STT_MODEL=gpt-transcribe

# Modelo do Google, quando VOICE_STT_PROVIDER=google. "long" é o padrão;
# NÃO use "short", que trunca (medido: 26% das palavras numa frase de 5,6s).
# "chirp_2"/"chirp_3" não existem na location "global".
# VOICE_STT_MODEL=long

# Religa o `adaptation` do Google (desligado porque não funciona).
# VOICE_STT_ADAPTATION=1

# Transcrição ao vivo (WebSocket /voice/realtime): o texto aparece na tela
# enquanto a pessoa fala. Não tem chave própria — liga sozinha quando
# VOICE_STT_PROVIDER=openai e OPENAI_API_KEY está preenchida, porque só a API
# da OpenAI expõe o modo realtime. Nos outros provedores o app simplesmente
# mostra o texto no fim da gravação, sem erro.

# Mensagem por voz (POST /voice/message — Fase 3):
# Raciocínio adaptativo desligado por padrão (ganho real medido: ~0,8s, não
# vale o risco de travar o primeiro token). Ligar sem precisar de deploy:
# VOICE_THINKING=1
#
# Tools de exclusão (deletar_tarefa, deletar_rotina, ...) ficam FORA do modo
# voz por padrão — uma transcrição pode errar "sim" por "sei" ou ruído, e
# apagar por engano é pior que criar por engano. Reabrir:
# VOICE_ALLOW_DESTRUCTIVE=1
